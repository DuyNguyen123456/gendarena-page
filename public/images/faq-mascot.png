<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <defs>
    <radialGradient id="bgGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.4"/>
      <stop offset="60%" stop-color="#112E81" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#050814" stop-opacity="1"/>
    </radialGradient>
    <linearGradient id="visorGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00F0FF"/>
      <stop offset="50%" stop-color="#7000FF"/>
      <stop offset="100%" stop-color="#3B82F6"/>
    </linearGradient>
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Outer Ring Base -->
  <circle cx="100" cy="100" r="94" fill="url(#bgGlow)" stroke="#00F0FF" stroke-width="3" filter="url(#neonGlow)" />
  <circle cx="100" cy="100" r="84" fill="none" stroke="#00F0FF" stroke-width="1" stroke-dasharray="6,4" opacity="0.6" />

  <!-- Robot Head Base -->
  <path d="M 50 85 C 50 55, 150 55, 150 85 L 145 130 C 145 150, 55 150, 55 130 Z" fill="#0B132B" stroke="#00F0FF" stroke-width="2" />

  <!-- Robot Ears / Antennas -->
  <rect x="36" y="80" width="14" height="30" rx="4" fill="#00F0FF" opacity="0.8" />
  <rect x="150" y="80" width="14" height="30" rx="4" fill="#00F0FF" opacity="0.8" />
  <circle cx="43" cy="65" r="4" fill="#00F0FF" filter="url(#neonGlow)" />
  <circle cx="157" cy="65" r="4" fill="#00F0FF" filter="url(#neonGlow)" />
  <line x1="43" y1="65" x2="43" y2="80" stroke="#00F0FF" stroke-width="2" />
  <line x1="157" y1="65" x2="157" y2="80" stroke="#00F0FF" stroke-width="2" />

  <!-- Cyber Visor / Eyes -->
  <path d="M 62 82 C 62 76, 138 76, 138 82 L 134 106 C 134 112, 66 112, 66 106 Z" fill="url(#visorGrad)" filter="url(#neonGlow)" />

  <!-- Eye Expressions (Animated Cyber Dots) -->
  <circle cx="85" cy="94" r="6" fill="#FFFFFF" />
  <circle cx="115" cy="94" r="6" fill="#FFFFFF" />

  <!-- Mouth / LED Grill -->
  <path d="M 80 126 Q 100 136 120 126" stroke="#00F0FF" stroke-width="3" fill="none" stroke-linecap="round" filter="url(#neonGlow)" />

  <!-- Chest Badge / Arena Logo Icon -->
  <polygon points="100,152 112,168 88,168" fill="#00F0FF" filter="url(#neonGlow)" />
  <text x="100" y="185" font-family="monospace" font-size="12" font-weight="bold" fill="#00F0FF" text-anchor="middle" letter-spacing="2">GEN-D</text>
</svg>
